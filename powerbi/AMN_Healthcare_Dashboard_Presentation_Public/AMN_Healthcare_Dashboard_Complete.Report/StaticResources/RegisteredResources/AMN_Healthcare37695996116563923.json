{
  "name": "AMN Healthcare Enterprise",
  "dataColors": [
    "#007F7B",
    "#3D78A3",
    "#8FD3CF",
    "#5D91B5",
    "#74AAA6",
    "#65727C"
  ],
  "background": "#F7FAFC",
  "foreground": "#263238",
  "tableAccent": "#138A86",
  "good": "#2E8B57",
  "neutral": "#E0A12B",
  "bad": "#C94C4C",
  "maximum": "#1976B9",
  "center": "#F4B400",
  "minimum": "#D64545",
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "show": true,
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 12,
            "fontColor": {
              "solid": {
                "color": "#263238"
              }
            }
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#DDE4E8"
              }
            },
            "radius": 6
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F7FAFC"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "value": [
          {
            "bold": true,
            "fontSize": 24,
            "fontColor": {
              "solid": {
                "color": "#173B57"
              }
            },
            "$id": "default"
          }
        ],
        "label": [
          {
            "show": true,
            "fontSize": 10,
            "fontColor": {
              "solid": {
                "color": "#526574"
              }
            },
            "$id": "default"
          }
        ],
        "cardCalloutArea": [
          {
            "show": true,
            "paddingUniform": 8,
            "rectangleRoundedCurve": 8,
            "backgroundFillColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backgroundTransparency": 0
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "fontFamily": "Segoe UI Semibold",
            "textSize": 10,
            "fontColor": {
              "solid": {
                "color": "#173B57"
              }
            },
            "outlineStyle": 0
          }
        ],
        "items": [
          {
            "fontFamily": "Segoe UI",
            "textSize": 9,
            "fontColor": {
              "solid": {
                "color": "#526574"
              }
            },
            "outlineStyle": 0,
            "padding": 2
          }
        ]
      }
    }
  },
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 14,
      "color": "#173B57"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#263238"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#65727C"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 24,
      "color": "#173B57"
    }
  }
}