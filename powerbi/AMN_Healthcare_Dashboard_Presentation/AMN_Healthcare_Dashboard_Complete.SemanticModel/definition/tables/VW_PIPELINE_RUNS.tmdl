table VW_PIPELINE_RUNS
	lineageTag: 746d5df8-58ae-43b5-a58d-8abab7cc9844

	measure 'Pipeline Runs' = ```
			
			        COUNTROWS('VW_PIPELINE_RUNS')
			```
		formatString: 0
		lineageTag: 59dec5f0-ec94-434f-b499-f42f7a25b076

	measure 'Successful Runs' = ```
			
			        CALCULATE(COUNTROWS('VW_PIPELINE_RUNS'), 'VW_PIPELINE_RUNS'[STATUS] = "SUCCEEDED")
			```
		formatString: 0
		lineageTag: 9bafc632-7009-4800-9c4d-bcde4847c405

	measure 'Failed Runs' = CALCULATE(COUNTROWS('VW_PIPELINE_RUNS'), 'VW_PIPELINE_RUNS'[STATUS] = "FAILED")
		formatString: 0
		lineageTag: 3ca3eeeb-5066-49d4-8670-89d63f528e4f

	measure 'Total Retry Count' = SUM('VW_PIPELINE_RUNS'[RETRY_COUNT])
		formatString: 0
		lineageTag: 7ae4aaf2-37ee-4865-b17c-ea53272e7dda

	measure 'Rows Processed' = SUM('VW_PIPELINE_RUNS'[ROWS_INSERTED]) + SUM('VW_PIPELINE_RUNS'[ROWS_UPDATED]) + SUM('VW_PIPELINE_RUNS'[ROWS_DELETED])
		formatString: #,0
		lineageTag: 51ca4b3a-2f57-487a-8423-e4645bd4c4c4

	measure 'Pipeline Success Rate' = ```
				
			        DIVIDE([Successful Runs], [Pipeline Runs])
			```
		formatString: 0.0%
		lineageTag: f7e60c25-8a50-409e-9360-86a4a4ac1296

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Runs Within SLA' = ```
			
			        CALCULATE(COUNTROWS('VW_PIPELINE_RUNS'), 'VW_PIPELINE_RUNS'[WITHIN_RUN_SLA] = TRUE())
			```
		formatString: 0
		lineageTag: f3dfb255-c2b3-4e1e-8459-e62aed65888c

	measure 'SLA Compliance' = ```
				
			        DIVIDE([Runs Within SLA], [Pipeline Runs])
			```
		formatString: 0.0%
		lineageTag: 6c656ed0-8573-4d22-ba2f-af70e1028eaa

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Runtime Seconds' = ```
			
			        AVERAGE('VW_PIPELINE_RUNS'[RUN_DURATION_SECONDS])
			```
		lineageTag: 185bbbca-864b-4fae-a32d-e2f7e1a227a8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Last Successful Load' = ```
			
			        CALCULATE(MAX('VW_PIPELINE_RUNS'[CURATED_AT]), 'VW_PIPELINE_RUNS'[STATUS] = "SUCCEEDED")
			```
		formatString: General Date
		lineageTag: 4d946b80-629b-4833-aeee-925a5911206a

