table DIM_CANDIDATE
	lineageTag: d4ee1c4b-5979-4454-b300-7ed85562b87e

	measure 'Total Candidates' = ```
			
			        DISTINCTCOUNT('DIM_CANDIDATE'[CANDIDATE_ID])
			```
		formatString: 0
		lineageTag: b560d6c4-7431-4f96-8b69-60ca13bc676b

	measure 'Available Candidates' = ```
			
			        CALCULATE(DISTINCTCOUNT('DIM_CANDIDATE'[CANDIDATE_ID]), 'DIM_CANDIDATE'[CANDIDATE_STATUS] IN {"AVAILABLE", "ACTIVE", "QUALIFIED"})
			```
		formatString: 0
		lineageTag: e9db01b0-b7f7-4788-ac72-c31d8cc81ced

	measure 'Placed Candidates' = ```
			
			        CALCULATE(DISTINCTCOUNT('DIM_CANDIDATE'[CANDIDATE_ID]), NOT ISBLANK('DIM_CANDIDATE'[EMPLOYEE_ID]))
			```
		formatString: 0
		lineageTag: e1c4a898-4318-4887-bea8-9d7cc663462c

	measure 'Active Placements' = ```
			
			        CALCULATE(DISTINCTCOUNT('DIM_CANDIDATE'[EMPLOYEE_ID]), NOT ISBLANK('DIM_CANDIDATE'[EMPLOYEE_ID]))
			```
		formatString: 0
		lineageTag: 0000a221-ff83-4018-afbc-6c5cc8c5cc90

	measure 'Placement Rate' = ```
				
			        DIVIDE([Placed Candidates], [Total Candidates])
			```
		formatString: 0.0%
		lineageTag: 7d041b01-5da5-4897-b5f1-3848e34a7f02

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Active Candidates' =
			CALCULATE(
			    DISTINCTCOUNT('DIM_CANDIDATE'[CANDIDATE_ID]),
			    'DIM_CANDIDATE'[CANDIDATE_STATUS] IN {"AVAILABLE", "ACTIVE", "QUALIFIED"}
			)
		formatString: 0
		lineageTag: 6eb127ce-f105-4db0-bbac-e68c789d5801

	measure Applications = DISTINCTCOUNT('DIM_CANDIDATE'[CANDIDATE_ID])
		formatString: 0
		lineageTag: 10434185-c6d5-460f-8965-a71056944684

	measure 'Credential-Ready Candidates' =
			CALCULATE(
			    DISTINCTCOUNT('DIM_CANDIDATE'[CANDIDATE_ID]),
			    'DIM_CANDIDATE'[CREDENTIAL_STATUS] IN {"VERIFIED", "CURRENT", "COMPLETE", "APPROVED"}
			)
		formatString: 0
		lineageTag: d882c35a-083d-421f-8a13-eea269f014bb

	measure 'Background-Cleared Candidates' =
			CALCULATE(
			    DISTINCTCOUNT('DIM_CANDIDATE'[CANDIDATE_ID]),
			    'DIM_CANDIDATE'[BACKGROUND_CHECK_STATUS] IN {"CLEARED", "PASSED", "COMPLETE", "APPROVED"}
			)
		formatString: 0
		lineageTag: 592d11cb-0e0b-419b-bba1-81c468a44541

