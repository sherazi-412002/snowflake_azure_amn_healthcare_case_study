model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-PK
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["DIM_CANDIDATE","DIM_DATE","DIM_HOSPITAL","FACT_PAYROLL","FACT_PLACEMENT_SCHEDULE","FACT_STAFFING_REQUEST","VW_EXECUTIVE_KPIS","VW_PIPELINE_LATEST_STATUS","VW_PIPELINE_RUNS","VW_RECRUITING_FUNNEL"]

annotation PBI_ProTooling = ["DaxQueryView_Desktop","DevMode"]

ref table DIM_CANDIDATE
ref table DIM_DATE
ref table DIM_HOSPITAL
ref table FACT_PAYROLL
ref table FACT_PLACEMENT_SCHEDULE
ref table FACT_STAFFING_REQUEST
ref table VW_EXECUTIVE_KPIS
ref table VW_PIPELINE_LATEST_STATUS
ref table VW_PIPELINE_RUNS
ref table VW_RECRUITING_FUNNEL

ref cultureInfo en-US

