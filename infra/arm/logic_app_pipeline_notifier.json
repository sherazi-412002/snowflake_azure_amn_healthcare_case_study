{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "logicAppName":       { "type": "string", "defaultValue": "logic-amn-dev-ionqqq" },
    "location":           { "type": "string", "defaultValue": "eastus2" },
    "gmailConnectionName":{ "type": "string", "defaultValue": "gmail-amn-notifier" }
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[parameters('gmailConnectionName')]",
      "location": "[parameters('location')]",
      "properties": {
        "displayName": "AMN Gmail Notifier",
        "api": {
          "id": "[concat(subscription().id, '/providers/Microsoft.Web/locations/', parameters('location'), '/managedApis/gmail')]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('logicAppName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', parameters('gmailConnectionName'))]"
      ],
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": { "defaultValue": {}, "type": "Object" }
          },
          "triggers": {
            "When_ADF_Pipeline_Calls": {
              "type": "Request",
              "kind": "Http",
              "inputs": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "pipeline_name": { "type": "string" },
                    "status":        { "type": "string" },
                    "run_id":        { "type": "string" },
                    "start_time":    { "type": "string" },
                    "error_message": { "type": "string" }
                  }
                }
              }
            }
          },
          "actions": {
            "Set_Status_Emoji": {
              "type": "InitializeVariable",
              "runAfter": {},
              "inputs": {
                "variables": [{
                  "name": "statusEmoji",
                  "type": "string",
                  "value": "@{if(equals(triggerBody()?['status'],'Succeeded'),'SUCCESS','FAILED')}"
                }]
              }
            },
            "Send_Email_via_Gmail": {
              "type": "ApiConnection",
              "runAfter": { "Set_Status_Emoji": ["Succeeded"] },
              "inputs": {
                "host": {
                  "connection": { "name": "@parameters('$connections')['gmail']['connectionId']" }
                },
                "method": "post",
                "path": "/v2/Mail",
                "body": {
                  "To": "syedshoaibsherazi412002@gmail.com",
                  "Subject": "@{concat('[AMN] ', triggerBody()?['pipeline_name'], ' - ', triggerBody()?['status'])}",
                  "Body": "@{concat('<html><body style=\"font-family:Arial,sans-serif;background:#f0f4f8;padding:24px\"><div style=\"max-width:580px;margin:auto\"><div style=\"background:#0D1B3E;border-radius:10px 10px 0 0;padding:24px 28px\"><h2 style=\"color:#fff;margin:0;font-size:20px\">AMN Healthcare</h2><p style=\"color:#00C2CB;margin:4px 0 0;font-size:13px\">Data Platform — Pipeline Notification</p></div><div style=\"background:#fff;border-radius:0 0 10px 10px;padding:28px\"><table style=\"width:100%;border-collapse:collapse;font-size:14px\"><tr><td style=\"padding:10px 0;border-bottom:1px solid #eee;color:#666;font-weight:600;width:140px\">Pipeline</td><td style=\"padding:10px 0;border-bottom:1px solid #eee;font-weight:700;color:#0D1B3E;font-size:15px\">', triggerBody()?['pipeline_name'], '</td></tr><tr><td style=\"padding:10px 0;border-bottom:1px solid #eee;color:#666;font-weight:600\">Status</td><td style=\"padding:10px 0;border-bottom:1px solid #eee;font-weight:700;font-size:15px;color:', if(equals(triggerBody()?['status'],'Succeeded'),'#22A06B','#D63B3B'), '\">', triggerBody()?['status'], if(equals(triggerBody()?['status'],'Succeeded'),' ✅',' ❌'), '</td></tr><tr><td style=\"padding:10px 0;border-bottom:1px solid #eee;color:#666;font-weight:600\">Run ID</td><td style=\"padding:10px 0;border-bottom:1px solid #eee;color:#555;font-size:12px;font-family:monospace\">', triggerBody()?['run_id'], '</td></tr><tr><td style=\"padding:10px 0;color:#666;font-weight:600\">Started</td><td style=\"padding:10px 0;color:#555\">', triggerBody()?['start_time'], '</td></tr>', if(not(equals(triggerBody()?['error_message'],'')), concat('<tr><td style=\"padding:10px 0;border-top:1px solid #eee;color:#D63B3B;font-weight:600\">Error</td><td style=\"padding:10px 0;border-top:1px solid #eee;color:#D63B3B;font-size:12px\">', triggerBody()?['error_message'], '</td></tr>'), ''), '</table></div><p style=\"text-align:center;font-size:11px;color:#aaa;margin-top:16px\">AMN Healthcare Data Platform &bull; Azure &bull; Snowflake &bull; Power BI</p></div></body></html>')}",
                  "IsHtml": true
                }
              }
            },
            "Respond_200": {
              "type": "Response",
              "runAfter": { "Send_Email_via_Gmail": ["Succeeded"] },
              "inputs": {
                "statusCode": 200,
                "body": {
                  "message": "Notification sent",
                  "pipeline": "@triggerBody()?['pipeline_name']",
                  "status": "@triggerBody()?['status']"
                }
              }
            }
          }
        },
        "parameters": {
          "$connections": {
            "value": {
              "gmail": {
                "connectionId": "[resourceId('Microsoft.Web/connections', parameters('gmailConnectionName'))]",
                "connectionName": "[parameters('gmailConnectionName')]",
                "id": "[concat(subscription().id, '/providers/Microsoft.Web/locations/', parameters('location'), '/managedApis/gmail')]"
              }
            }
          }
        }
      }
    }
  ],
  "outputs": {
    "logicAppTriggerUrl": {
      "type": "string",
      "value": "[listCallbackURL(concat(resourceId('Microsoft.Logic/workflows', parameters('logicAppName')), '/triggers/When_ADF_Pipeline_Calls'), '2019-05-01').value]"
    }
  }
}
